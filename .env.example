# Proyecto Supabase exclusivo de Marisquería OS. No reutilizar valores de otros proyectos.
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR

# Sólo para scripts locales de administración/seed. Nunca usar en NEXT_PUBLIC_* ni en el navegador.
# Clave secreta del proyecto (sb_secret_...). Sólo servidor; jamás NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Copiloto y estudio creativo. Sólo servidor.
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-5.6-sol
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_ASSISTANT_REQUESTS_PER_MINUTE=12

# Meta / WhatsApp Business Cloud API (se activa desde Integraciones).
META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
